# Copie este arquivo pra .env e ajuste se necessário.
# .env é gitignored.

# --- URLs ---
FRONT_URL=http://localhost:4200
BACK_URL=https://localhost:1501

# --- Banco local (criado em c:\Pessoal\admin via Postgres 18 local) ---
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=adminbackend
PSQL_PATH=C:\Program Files\PostgreSQL\18\bin\psql.exe

# --- Backend ---
# Connection string usada pelo `dotnet run` quando o Playwright sobe a stack.
# Sobrescreve appsettings.Development.json (que aponta pra Railway).
BACK_CONNECTION_STRING=Host=localhost;Port=5432;Database=adminbackend;Username=postgres;Password=postgres
BACK_PROJECT_PATH=../admin-backend/src/AdminBackend.Api

# --- Frontend ---
FRONT_PROJECT_PATH=../admin-frontend

# --- Comportamento dos testes ---
# Quando true, Playwright não tenta subir back/front (você sobe à mão).
SKIP_WEBSERVER=false
